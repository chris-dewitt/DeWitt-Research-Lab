{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json",
  "title": "DRL Artifact Reference",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "document",
        "dataset",
        "model",
        "evidence_bundle",
        "calculation",
        "report",
        "trace",
        "diff",
        "chart",
        "file",
        "other"
      ]
    },
    "uri": {
      "type": "string",
      "maxLength": 2048
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "public",
        "drl-private",
        "local-personal",
        "secret",
        "restricted"
      ]
    },
    "media_type": {
      "type": "string",
      "maxLength": 200
    },
    "title": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "maxLength": 100
    },
    "rights_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "uri",
    "digest",
    "classification",
    "created_at",
    "source_system"
  ]
}
