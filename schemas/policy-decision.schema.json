{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/policy-decision.schema.json",
  "title": "DRL Policy Decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "tool_call_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "approval_required"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "policy_version": {
      "type": "string",
      "maxLength": 100
    },
    "matched_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "required_approval_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "reason_code": {
      "type": "string",
      "maxLength": 200
    },
    "safe_explanation": {
      "type": "string",
      "maxLength": 4000
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "correlation_id",
    "trace_id",
    "run_id",
    "tool_call_id",
    "decision",
    "risk_tier",
    "policy_version",
    "reason_code",
    "safe_explanation",
    "expires_at"
  ]
}
