{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/tool-definition.schema.json",
  "title": "DRL Tool Definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "input_schema": {
      "type": "object"
    },
    "output_schema": {
      "type": "object"
    },
    "required_scopes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "effect_type": {
      "type": "string",
      "enum": [
        "observe",
        "read",
        "draft",
        "modify",
        "external_effect",
        "privileged",
        "prohibited"
      ]
    },
    "approval_policy": {
      "type": "string",
      "enum": [
        "never",
        "policy",
        "always",
        "prohibited"
      ]
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 3600000
    },
    "network_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "data_handling": {
      "type": "object",
      "additionalProperties": true
    },
    "provider": {
      "type": "string",
      "maxLength": 200
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "name",
    "version",
    "description",
    "input_schema",
    "output_schema",
    "required_scopes",
    "risk_tier",
    "effect_type",
    "approval_policy",
    "timeout_ms",
    "digest"
  ]
}
