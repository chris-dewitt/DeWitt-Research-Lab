DRL_ENV=local
DRL_LOG_LEVEL=INFO
DRL_DATABASE_URL=postgresql://drl:drl@localhost:5432/drl
DRL_REDIS_URL=redis://localhost:6379/0
DRL_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
DRL_OBJECT_STORAGE_BUCKET=drl-local
DRL_MODEL_PROVIDER=mock
DRL_MODEL_ID=mock-atticus
# Atticus planner (unset = deterministic fixture planner, including CI)
# ATTICUS_MODEL=hf.co/Qwen/Qwen3-1.7B-GGUF:Q8_0
# ATTICUS_MODEL_BASE_URL=http://localhost:11434/v1
# ATTICUS_MODEL_NO_THINKING=1
# ATTICUS_MODEL_LICENSE=Apache-2.0
DRL_TELEMETRY_ENABLED=false
DRL_PRODUCT_ANALYTICS_ENABLED=false
# Official public feeds (opt-in; fixtures remain the default)
# ATTICUS_LIVE_DATA=1
# DRL_FEED_ROOT=data/public-feeds
# FRED_API_KEY=   # operator-owned; never commit
# Never place real credentials in this file.

# Canonical public laboratory origins (not secrets)
DRL_CANONICAL_ORIGIN=https://www.dewitt-labs.com
DRL_ATTICUS_ORIGIN=https://atticus.dewitt-labs.com
DRL_DOCS_ORIGIN=https://docs.dewitt-labs.com
DRL_STATUS_ORIGIN=https://status.dewitt-labs.com
