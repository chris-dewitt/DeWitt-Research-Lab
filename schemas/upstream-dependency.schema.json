{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/upstream-dependency.schema.json",
  "title": "DRL Upstream Dependency Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "dependency_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,99}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "license_expression": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "enum": [
        "open_source_software",
        "open_weight_model",
        "source_available",
        "managed_service",
        "standard",
        "dataset",
        "other"
      ]
    },
    "version_policy": {
      "type": "string",
      "minLength": 1
    },
    "criticality": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "drl_role": {
      "type": "string",
      "minLength": 1
    },
    "exit_strategy": {
      "type": "string",
      "minLength": 10
    },
    "upstream_contributions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "review_by": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "schema_version",
    "dependency_id",
    "name",
    "canonical_url",
    "license_expression",
    "classification",
    "version_policy",
    "criticality",
    "owner",
    "drl_role",
    "exit_strategy",
    "upstream_contributions",
    "reviewed_at",
    "review_by"
  ]
}
