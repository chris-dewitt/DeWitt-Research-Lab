{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/open-artifact-release.schema.json",
  "title": "DRL Open Artifact Release",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "artifact_class": {
      "enum": [
        "software",
        "model",
        "dataset",
        "research",
        "deployment",
        "teaching"
      ]
    },
    "classification": {
      "enum": [
        "open_source_software",
        "open_source_ai",
        "open_weight_model",
        "source_available",
        "public_only",
        "restricted"
      ]
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "source_revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 200
    },
    "license_expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "upstream_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "modification_surface": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reproducibility_level": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "forkability_status": {
      "enum": [
        "not_tested",
        "failed",
        "partial",
        "passed"
      ]
    },
    "lifecycle": {
      "enum": [
        "experimental",
        "alpha",
        "beta",
        "stable",
        "deprecated",
        "archived",
        "withdrawn"
      ]
    },
    "release_manifest_uri": {
      "type": "string",
      "format": "uri"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "name",
    "artifact_class",
    "classification",
    "version",
    "source_revision",
    "license_expression",
    "upstream_ids",
    "modification_surface",
    "reproducibility_level",
    "forkability_status",
    "lifecycle",
    "release_manifest_uri",
    "digest",
    "exceptions"
  ]
}
