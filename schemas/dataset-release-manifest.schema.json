{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/dataset-release-manifest.schema.json",
  "title": "DRL Dataset Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "maxLength": 100
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": "object",
      "additionalProperties": true
    },
    "records": {
      "type": "integer",
      "minimum": 0
    },
    "splits": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": true
    },
    "contamination_report": {
      "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "released_at",
    "license",
    "records",
    "splits",
    "sources",
    "review",
    "contamination_report",
    "artifacts",
    "manifest_digest"
  ]
}
