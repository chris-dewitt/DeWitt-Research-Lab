{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/model-release-manifest.schema.json",
  "title": "DRL Model Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "name": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "maxLength": 100
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": true
    },
    "license": {
      "type": "object",
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
      }
    },
    "training_data_manifests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
      }
    },
    "evaluation_result_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
      }
    },
    "runtime_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "released_at",
    "upstream",
    "license",
    "artifacts",
    "training_data_manifests",
    "evaluation_result_ids",
    "runtime_profiles",
    "cards",
    "manifest_digest"
  ]
}
