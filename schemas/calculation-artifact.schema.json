{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/calculation-artifact.schema.json",
  "title": "DRL Calculation Artifact",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "system": {
      "type": "string",
      "maxLength": 100
    },
    "method_name": {
      "type": "string",
      "maxLength": 300
    },
    "method_version": {
      "type": "string",
      "maxLength": 200
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
      }
    },
    "normalized_inputs": {
      "type": "object"
    },
    "assumptions": {
      "type": "object"
    },
    "results": {
      "type": "object"
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": true
    },
    "code_revision": {
      "type": "string",
      "maxLength": 200
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "created_at",
    "system",
    "method_name",
    "method_version",
    "normalized_inputs",
    "assumptions",
    "results",
    "units",
    "reconciliation",
    "code_revision",
    "environment_digest",
    "artifact_digest",
    "limitations"
  ]
}
