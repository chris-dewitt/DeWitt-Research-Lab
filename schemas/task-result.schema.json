{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/task-result.schema.json",
  "title": "DRL Task Result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "expired",
        "degraded"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "safe_summary": {
      "type": "string",
      "maxLength": 20000
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/claim.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.dewittresearch.org/drl/v1/artifact-reference.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4000
      }
    },
    "error": {
      "anyOf": [
        {
          "$ref": "https://schemas.dewittresearch.org/drl/v1/drl-error.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "task_id",
    "run_id",
    "status",
    "created_at",
    "safe_summary",
    "claims",
    "artifacts",
    "limitations",
    "trace_id"
  ]
}
