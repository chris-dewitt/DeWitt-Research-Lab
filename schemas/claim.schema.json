{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dewittresearch.org/drl/v1/claim.schema.json",
  "title": "DRL Claim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "direct_evidence",
        "deterministic_result",
        "inference",
        "hypothesis",
        "limitation",
        "unknown"
      ]
    },
    "supporting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
      }
    },
    "contradicting_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
      }
    },
    "calculation_artifact_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
      }
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence_basis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "text",
    "claim_type",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "calculation_artifact_ids",
    "as_of"
  ]
}
